# Copier en .env.bench (ignoré par git) et renseigner les moteurs à tester.
# Un moteur sans ses clés est simplement ignoré. Ne jamais mettre de clé dans ce fichier-ci.

# Azure AI Speech — ressource « Speech » dans le portail Azure, région France Central
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=francecentral

# Mistral — console.mistral.ai > API keys
MISTRAL_API_KEY=

# Cloudflare Workers AI — identifiant de compte ; jeton API « Compte › Workers AI › Modifier »
CF_ACCOUNT_ID=
CF_API_TOKEN=
